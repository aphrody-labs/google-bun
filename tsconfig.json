{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["bun"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "cloud/**/*.ts",
    "workspace/**/*.ts",
    "devtools/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "third_party"]
}
